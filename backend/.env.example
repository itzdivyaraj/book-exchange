# Copy this file to ".env" and change values if needed.
# Never commit the real .env to GitHub (it's in .gitignore).
# On Render, the same settings are typed into the dashboard instead (see render.yaml).

# ---------- Database ----------
# Laptop: a SQLite file. Nothing to install.
DATABASE_URL=sqlite:///./books.db
# Live: the connection string from Neon, e.g.
# DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require

# Days a login stays valid
SESSION_DAYS=30

# Websites allowed to call this API (comma-separated). Live: add your Vercel address.
FRONTEND_ORIGINS=http://localhost:5173

# ---------- Photos ----------
# local = uploads/ folder (laptop). cloudinary = online (live).
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
PUBLIC_BASE_URL=http://127.0.0.1:8000
MAX_UPLOAD_MB=5
# Live only (a SECRET): CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

# ---------- Email ----------
# console = print emails in the Terminal (laptop). brevo = really send (live).
EMAIL_BACKEND=console
EMAIL_FROM=Book Exchange <no-reply@example.com>
# Live only (a SECRET): BREVO_API_KEY=xkeysib-...
BREVO_API_KEY=
