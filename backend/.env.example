# Copy this file to ".env" and change values if needed.
# Never commit the real .env to GitHub (it's in .gitignore).

# Local development: a SQLite file. Nothing to install.
DATABASE_URL=sqlite:///./books.db

# When you go live, replace with the Postgres URL from Neon, e.g.
# DATABASE_URL=postgresql+psycopg://user:password@ep-xxxx.neon.tech/neondb?sslmode=require

# Days a login stays valid
SESSION_DAYS=30

# Websites allowed to call this API (comma-separated)
FRONTEND_ORIGINS=http://localhost:5173

# Photos (step 2)
UPLOAD_DIR=uploads
PUBLIC_BASE_URL=http://127.0.0.1:8000
MAX_UPLOAD_MB=5
